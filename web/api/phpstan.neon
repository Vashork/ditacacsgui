parameters:
    level: 8
    paths:
        - app
        - bootstrap
        - self
    excludePaths:
        - vendor/*
    # Slim 4 + PHP-DI resolve controllers via the DI container at runtime
    # (string keys / FQCN auto-wiring in bootstrap/app.php), so a class of
    # messages is false-positive from the container-based wiring. We keep
    # level 8 for the real issues (dead code, unused imports/vars, types) and
    # ignore the known dynamic-resolution noise below rather than drop the level.
    ignoreErrors:
        # Controllers are resolved via the DI container (string keys + FQCN
        # auto-wiring); static analysis can't see the runtime bindings.
        - '#Class tgui\\.* not found#'
        - '#Access to an undefined constant#'
        # $_SESSION / $_POST / $_SERVER / $_ENV are framework globals used
        # throughout (pre-Slim-4 request wrappers in some legacy handlers).
        - identifier: variable.undefined
        - identifier: constant.notFound
    treatPhpDocTypesAsCertain: false
