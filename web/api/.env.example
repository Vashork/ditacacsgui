# TacacsGUI Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=TacacsGUI
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database
# DB_DRIVER: mysql (production) | sqlite (local dev smoke-test, no MySQL needed)
DB_DRIVER=mysql
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tgui
DB_DATABASE_LOG=tgui_log
DB_USERNAME=tgui_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600

# TACACS+ Configuration
TAC_ROOT_PATH=/opt/tacacsgui
TAC_PLUS_CFG=/opt/tacacsgui/tac_plus.cfg
TAC_PLUS_CFG_TEST=/opt/tacacsgui/tac_plus.cfg_test
TAC_PLUS_PARSING=/opt/tacacsgui/tacTestOutput.txt
TAC_DEAMON=/opt/tacacsgui/tac_plus.sh

# Backup
BACKUP_PATH=/opt/tacacsgui/backup/database/

# High Availability
HA_SETTINGS_PATH=/opt/tgui_data/ha/ha-settings.yaml
HA_MASTER_PATH=/opt/tgui_data/ha/ha-master.yaml
HA_SLAVES_PATH=/opt/tgui_data/ha/ha-slaves.yaml

# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=smtp@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=TacacsGUI

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_PATH=/var/log/tacacsgui/

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file
CACHE_PATH=/tmp/tacacsgui/cache

# Queue
QUEUE_DRIVER=sync
